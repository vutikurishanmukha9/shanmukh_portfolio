{
  "rewrites": [
    {
      "source": "/((?!assets/|favicon.*|apple-touch-icon.png|Shanmukh.png|placeholder.svg).*)/",
      "destination": "/index.html"
    },
    {
      "source": "/case-study/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
